# Twilio Console → Account → API keys & tokens → Create API key (Standard)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your-api-key-secret

# Twilio Console → Voice → TwiML → TwiML Apps → Create new TwiML App
# Voice webhook (when a call comes in) = POST {PUBLIC_URL}/api/voice
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio Console → Phone Numbers → the number reps call out from —
# also the number SMS sends from (and must have SMS capability) unless
# TWILIO_MESSAGING_SERVICE_SID below is set. Set exactly one of
# TWILIO_CALLER_ID or TWILIO_CALLER_IDS.
TWILIO_CALLER_ID=+61xxxxxxxxx

# Optional — rotate outbound calls across several numbers instead of
# one, to spread call volume so no single number gets carrier-flagged.
# Comma-separated, each must be a real number on this Twilio account
# with Voice capability. Takes priority over TWILIO_CALLER_ID above
# when set (leave TWILIO_CALLER_ID out entirely, or ignore it, either
# is fine). SMS still always sends from the first number in this list.
# TWILIO_CALLER_IDS=+61xxxxxxxxx,+61xxxxxxxxx,+61xxxxxxxxx,+61xxxxxxxxx

# Optional. Twilio Console → Messaging → Services → Create Messaging
# Service → add each caller ID number as a Sender. Recommended by
# Twilio for SMS (better deliverability), but not required — outbound
# SMS falls back to sending from the first caller ID directly if this
# is unset.
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Only needed for multi-line dialling (Powerdialler → "Lines" > 1),
# and only in local dev — the Vercel deployment already knows its own
# URL. Multi-line dialling places each lead's call itself and has to
# tell Twilio a URL to fetch TwiML from and post status updates to;
# unlike the webhooks above (pasted into the Twilio Console once),
# those are generated per call, so Twilio needs to be able to reach
# your backend directly. Set this to the same ngrok URL you're using
# for the Voice webhook, e.g. https://abcd1234.ngrok-free.app — no
# trailing slash.
# PUBLIC_URL=https://your-ngrok-subdomain.ngrok-free.app

# Google Cloud Console (console.cloud.google.com) → APIs & Services →
# Credentials → Create Credentials → OAuth client ID → Web application.
# Enable the "Google Calendar API" and "Gmail API" first (APIs &
# Services → Library). Add an Authorized redirect URI of
# {PUBLIC_URL or your Vercel domain}/api/google-callback — in local
# dev without a tunnel that's http://localhost:3001/api/google-callback.
# Used by the Booking tab (each rep connects their own Google account —
# there's no shared account here).
GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Vercel dashboard → your project → Storage tab → Create Database →
# Postgres (Neon) → Connect. Vercel adds this automatically once
# connected — for local dev, copy its value from Project Settings →
# Environment Variables into here.
POSTGRES_URL=postgres://user:password@host/dbname?sslmode=require

# Any long random string — used to sign login session cookies (JWT).
# Generate one with: openssl rand -hex 32
# Must be set in both local .env and your Vercel project's env vars,
# and must be the SAME value in both if you want sessions to be
# interchangeable — in practice each just needs its own value set.
SESSION_SECRET=replace-with-a-long-random-string

# Local backend port
PORT=3001

# LOCAL DEV ONLY — points the frontend at the separate Express server
# above (npm run server) instead of same-origin /api. Leave this unset
# in your Vercel project's env vars: on the deployed site the /api/*
# functions live on the same domain as the frontend already.
VITE_CALL_SERVER_URL=http://localhost:3001
