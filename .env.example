# Twilio Console → Account → API keys & tokens → Create API key (Standard)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your-api-key-secret

# Twilio Console → Voice → TwiML → TwiML Apps → Create new TwiML App
# Voice webhook (when a call comes in) = POST {PUBLIC_URL}/api/voice
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio Console → Phone Numbers → the number reps call out from —
# also the number SMS sends from (and must have SMS capability) unless
# TWILIO_MESSAGING_SERVICE_SID below is set. Set exactly one of
# TWILIO_CALLER_ID or TWILIO_CALLER_IDS.
TWILIO_CALLER_ID=+61xxxxxxxxx

# Optional — rotate outbound calls across several numbers instead of
# one, to spread call volume so no single number gets carrier-flagged.
# Comma-separated, each must be a real number on this Twilio account
# with Voice capability. Takes priority over TWILIO_CALLER_ID above
# when set (leave TWILIO_CALLER_ID out entirely, or ignore it, either
# is fine). SMS still always sends from the first number in this list.
# TWILIO_CALLER_IDS=+61xxxxxxxxx,+61xxxxxxxxx,+61xxxxxxxxx,+61xxxxxxxxx

# Optional. Twilio Console → Messaging → Services → Create Messaging
# Service → add each caller ID number as a Sender. Recommended by
# Twilio for SMS (better deliverability), but not required — outbound
# SMS falls back to sending from the first caller ID directly if this
# is unset.
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Only needed for multi-line dialling (Powerdialler → "Lines" > 1),
# and only in local dev — the Vercel deployment already knows its own
# URL. Multi-line dialling places each lead's call itself and has to
# tell Twilio a URL to fetch TwiML from and post status updates to;
# unlike the webhooks above (pasted into the Twilio Console once),
# those are generated per call, so Twilio needs to be able to reach
# your backend directly. Set this to the same ngrok URL you're using
# for the Voice webhook, e.g. https://abcd1234.ngrok-free.app — no
# trailing slash.
# PUBLIC_URL=https://your-ngrok-subdomain.ngrok-free.app

# Vercel dashboard → your project → Storage tab → Create Database →
# Postgres (Neon) → Connect. Vercel adds this automatically once
# connected — for local dev, copy its value from Project Settings →
# Environment Variables into here.
POSTGRES_URL=postgres://user:password@host/dbname?sslmode=require

# Any long random string — used to sign login session cookies (JWT).
# Generate one with: openssl rand -hex 32
# Must be set in both local .env and your Vercel project's env vars,
# and must be the SAME value in both if you want sessions to be
# interchangeable — in practice each just needs its own value set.
SESSION_SECRET=replace-with-a-long-random-string

# Local backend port
PORT=3001

# LOCAL DEV ONLY — points the frontend at the separate Express server
# above (npm run server) instead of same-origin /api. Leave this unset
# in your Vercel project's env vars: on the deployed site the /api/*
# functions live on the same domain as the frontend already.
VITE_CALL_SERVER_URL=http://localhost:3001

# ---------- Calendars (Google Calendar + booking widget) ----------
# Google Cloud Console (console.cloud.google.com) → create/select a
# project → APIs & Services → Library → enable "Google Calendar API"
# → APIs & Services → Credentials → Create Credentials → OAuth client
# ID → Application type "Web application". Add this Authorized
# redirect URI (both your local dev URL and your real deployed domain,
# as two separate entries — Google requires an exact match):
#   {PUBLIC_URL or your Vercel domain}/api/calendar-google-callback
# You'll also need to add yourself as a Test user (or publish the
# consent screen) under APIs & Services → OAuth consent screen while
# the app is unverified. Once set, every user just clicks "Connect
# with Google" in Calendar settings — no further setup per user.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# SendGrid (app.sendgrid.com) → Settings → API Keys → Create API Key
# (Restricted Access is fine — just needs "Mail Send"). FROM must be a
# verified sender or domain under Settings → Sender Authentication, or
# SendGrid will reject every send.
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=bookings@yourdomain.com
SENDGRID_FROM_NAME=Your Company

# Optional but recommended once deployed — secures the cron endpoint
# that advances Automations' "wait" steps (/api/automations-process-runs)
# so only Vercel's own Cron Jobs can call it. Generate one with
# `openssl rand -hex 32`, same as SESSION_SECRET, and set it in Vercel
# too — Vercel automatically sends it as a Bearer token when invoking
# a Cron Job if this env var is present. Without it, that one endpoint
# is reachable by anyone (it does nothing destructive, just advances
# due automation steps, but there's no reason to leave it open).
# NOTE: Vercel Cron on the Hobby plan only fires once a day — the
# every-minute schedule in vercel.json needs a Pro plan to actually
# run that often; on Hobby, "wait" steps will only advance roughly
# once daily. Local dev doesn't need this — server/index.js polls on
# its own every 15s.
CRON_SECRET=replace-with-a-long-random-string

# ---------- AI Voice tab ----------
# Optional — all four of these can instead be entered from inside the
# app (AI Voice tab → Settings), no redeploy needed; a key saved there
# takes priority over the one here. Useful as the fallback for a
# shared/default deployment, or if you'd rather manage secrets outside
# the app's own DB.
#
# console.anthropic.com → Settings → API Keys. Powers the assistant's
# replies (Claude).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# console.deepgram.com → API Keys → Create a New API Key. Powers
# speech-to-text (turning a caller's recorded turn into text).
DEEPGRAM_API_KEY=your-deepgram-api-key

# elevenlabs.io → Profile → API Keys. Powers text-to-speech (turning
# the assistant's reply into a voice clip).
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Optional — an ElevenLabs voice ID from your Voice Library (Voices →
# a voice → copy ID) to use instead of the generic default voice.
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
