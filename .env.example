# Twilio Console → Account → API keys & tokens → Create API key (Standard)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your-api-key-secret

# Twilio Console → Voice → TwiML → TwiML Apps → Create new TwiML App
# Voice webhook (when a call comes in) = POST {PUBLIC_URL}/api/voice
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio Console → Phone Numbers → the number reps call out from
TWILIO_CALLER_ID=+61xxxxxxxxx

# Vercel dashboard → your project → Storage tab → Create Database →
# Postgres (Neon) → Connect. Vercel adds this automatically once
# connected — for local dev, copy its value from Project Settings →
# Environment Variables into here.
POSTGRES_URL=postgres://user:password@host/dbname?sslmode=require

# Local backend port
PORT=3001

# LOCAL DEV ONLY — points the frontend at the separate Express server
# above (npm run server) instead of same-origin /api. Leave this unset
# in your Vercel project's env vars: on the deployed site the /api/*
# functions live on the same domain as the frontend already.
VITE_CALL_SERVER_URL=http://localhost:3001
